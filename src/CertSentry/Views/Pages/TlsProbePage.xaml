<Page
    x:Class="CertSentry.Views.Pages.TlsProbePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:CertSentry.Views.Converters"
    mc:Ignorable="d"
    d:DesignHeight="950" d:DesignWidth="1100"
    Title="TLS Probe">

    <Page.Resources>
        <converters:HealthStatusToBrushConverter x:Key="HealthStatusToBrush" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32">

            <!-- Title -->
            <TextBlock Text="TLS Connection Doctor &amp; Live Probe" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Probe live localhost endpoints, inspect socket handshakes, analyze cipher suites, and diagnose certificate chain errors." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,20" />

            <!-- Notification banner -->
            <ui:InfoBar
                IsOpen="True"
                Severity="Informational"
                Message="{Binding ViewModel.CopyNotification}"
                Visibility="{Binding ViewModel.CopyNotification, Converter={StaticResource StringNotEmptyToVisibility}}"
                Margin="0,0,0,16" />

            <!-- Input Bar Card -->
            <ui:Card Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox
                            Grid.Column="0"
                            PlaceholderText="Enter local HTTPS URL (e.g. https://localhost:5001 or 127.0.0.1:3000)"
                            Text="{Binding ViewModel.TargetUrl, UpdateSourceTrigger=PropertyChanged}"
                            Icon="{ui:SymbolIcon Symbol=Globe24}"
                            Margin="0,0,12,0" />

                        <ui:Button
                            Grid.Column="1"
                            Appearance="Primary"
                            Icon="{ui:SymbolIcon Symbol=Play24}"
                            Content="Probe TLS Handshake"
                            Command="{Binding ViewModel.ProbeEndpointCommand}" />
                    </Grid>

                    <!-- Quick Presets -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Presets:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,8,0" />
                        <ui:Button Content="ASP.NET (5001)" Padding="8,4" FontSize="11" Margin="0,0,6,0" Command="{Binding ViewModel.SetPresetCommand}" CommandParameter="https://localhost:5001" />
                        <ui:Button Content="React/Node (3000)" Padding="8,4" FontSize="11" Margin="0,0,6,0" Command="{Binding ViewModel.SetPresetCommand}" CommandParameter="https://localhost:3000" />
                        <ui:Button Content="Vite (5173)" Padding="8,4" FontSize="11" Margin="0,0,6,0" Command="{Binding ViewModel.SetPresetCommand}" CommandParameter="https://localhost:5173" />
                        <ui:Button Content="Dev Proxy (8443)" Padding="8,4" FontSize="11" Margin="0,0,6,0" Command="{Binding ViewModel.SetPresetCommand}" CommandParameter="https://localhost:8443" />
                        <ui:Button Content="Minimal API (7001)" Padding="8,4" FontSize="11" Margin="0,0,6,0" Command="{Binding ViewModel.SetPresetCommand}" CommandParameter="https://localhost:7001" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- Loading Indicator -->
            <ui:ProgressRing IsIndeterminate="True" Visibility="{Binding ViewModel.IsProbing, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Center" Margin="0,16" />

            <!-- Probe Results Container -->
            <StackPanel Visibility="{Binding ViewModel.Result, Converter={StaticResource NullToVisibility}}">

                <!-- Verdict Banner -->
                <ui:Card Margin="0,0,0,16" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="22" Foreground="#107C41" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding ViewModel.Result.VerdictTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ViewModel.Result.VerdictDescription}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Latency Breakdown -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding ViewModel.Result.DnsResolutionMs, StringFormat='{}{0} ms'}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" />
                                    <TextBlock Text="DNS" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding ViewModel.Result.TcpConnectMs, StringFormat='{}{0} ms'}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" />
                                    <TextBlock Text="TCP Connect" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding ViewModel.Result.TlsHandshakeMs, StringFormat='{}{0} ms'}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" />
                                    <TextBlock Text="TLS Handshake" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- Cryptography & Connection Details -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Handshake Parameters -->
                    <ui:Card Grid.Column="0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Negotiated Handshake" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Protocol Version:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding ViewModel.Result.TlsProtocolVersion}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Cipher Suite:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding ViewModel.Result.NegotiatedCipherSuite}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Application Protocol (ALPN):" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding ViewModel.Result.ApplicationProtocol}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Target Host &amp; Port:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding ViewModel.Result.TargetUrl}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Resolved IP:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding ViewModel.Result.ResolvedIp}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <!-- Server Certificate Details -->
                    <ui:Card Grid.Column="2" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Server Certificate" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Common Name:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding ViewModel.Result.ServerCertificate.CommonName}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Validity:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding ViewModel.Result.ServerCertificate.ExpirationSummary}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Key Algorithm:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding ViewModel.Result.ServerCertificate.KeyAlgorithm, StringFormat='{}{0}'}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="SANs:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding ViewModel.Result.ServerCertificate.SansDisplaySummary}" TextTrimming="CharacterEllipsis" MaxWidth="260" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Thumbprint:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding ViewModel.Result.ServerCertificate.Thumbprint}" TextTrimming="CharacterEllipsis" MaxWidth="220" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </ui:Card>
                </Grid>

                <!-- Actions Bar -->
                <ui:Card Margin="0,0,0,16" Padding="12,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button
                            Appearance="Primary"
                            Icon="{ui:SymbolIcon Symbol=ShieldKeyhole24}"
                            Content="Trust This Certificate into Windows Root"
                            Command="{Binding ViewModel.TrustServerCertificateCommand}"
                            Margin="0,0,8,0" />
                        <ui:Button
                            Icon="{ui:SymbolIcon Symbol=Copy24}"
                            Content="Copy Public PEM"
                            Command="{Binding ViewModel.CopyPemCommand}"
                            Margin="0,0,8,0" />
                        <ui:Button
                            Icon="{ui:SymbolIcon Symbol=DocumentCopy24}"
                            Content="Copy Full Report"
                            Command="{Binding ViewModel.CopyDetailsCommand}" />
                    </StackPanel>
                </ui:Card>

                <!-- Issues & Remedies -->
                <TextBlock Text="Diagnostic Findings &amp; Warnings" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,8" />
                <ItemsControl ItemsSource="{Binding ViewModel.Result.Issues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="0,0,0,8" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{Binding Severity, Converter={StaticResource HealthStatusToBrush}}" Margin="0,0,14,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,4" />
                                        <TextBlock Text="{Binding Remedy, StringFormat='Remedy: {0}'}" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Certificate Chain Hierarchy -->
                <TextBlock Text="Certificate Chain Hierarchy" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,8" />
                <ItemsControl ItemsSource="{Binding ViewModel.Result.CertificateChain}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="0,0,0,8" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon Grid.Column="0" Symbol="Certificate24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding ExpirationSummary}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding Thumbprint}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
