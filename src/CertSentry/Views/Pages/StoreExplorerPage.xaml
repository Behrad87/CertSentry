<Page
    x:Class="CertSentry.Views.Pages.StoreExplorerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:CertSentry.Views.Converters"
    mc:Ignorable="d"
    d:DesignHeight="850" d:DesignWidth="1100"
    Title="Certificate Store Explorer">

    <Page.Resources>
        <converters:HealthStatusToBrushConverter x:Key="HealthStatusToBrush" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Certificate Store Explorer" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock Grid.Row="0" Text="Browse, inspect, export, trust, and manage certificates in Windows Certificate Stores." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,34,0,16" />

        <!-- Notification Bar -->
        <ui:InfoBar
            Grid.Row="1"
            IsOpen="True"
            Severity="Informational"
            Message="{Binding ViewModel.NotificationMessage}"
            Visibility="{Binding ViewModel.NotificationMessage, Converter={StaticResource StringNotEmptyToVisibility}}"
            Margin="0,0,0,12" />

        <!-- Controls / Filter Bar -->
        <ui:Card Grid.Row="2" Padding="12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Store Selector -->
                <ComboBox
                    Grid.Column="0"
                    SelectedIndex="{Binding ViewModel.SelectedStoreIndex}"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center">
                    <ComboBoxItem Content="CurrentUser \ Personal (My)" />
                    <ComboBoxItem Content="CurrentUser \ Trusted Root" />
                    <ComboBoxItem Content="CurrentUser \ Intermediate CA" />
                    <ComboBoxItem Content="LocalMachine \ Personal (My)" />
                    <ComboBoxItem Content="LocalMachine \ Trusted Root" />
                </ComboBox>

                <!-- Dev Certs Only Toggle -->
                <CheckBox
                    Grid.Column="1"
                    Content="Dev &amp; Localhost Only"
                    IsChecked="{Binding ViewModel.DevCertsOnly}"
                    VerticalAlignment="Center"
                    Margin="0,0,16,0" />

                <!-- Search Box -->
                <ui:TextBox
                    Grid.Column="2"
                    PlaceholderText="Search certificates by Subject, SAN, Thumbprint..."
                    Text="{Binding ViewModel.SearchText, UpdateSourceTrigger=PropertyChanged}"
                    Icon="{ui:SymbolIcon Symbol=Search24}"
                    Margin="0,0,12,0" />

                <!-- Reload Button -->
                <ui:Button
                    Grid.Column="3"
                    Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}"
                    Content="Reload"
                    Command="{Binding ViewModel.LoadCertificatesCommand}" />
            </Grid>
        </ui:Card>

        <!-- Main Explorer Content: Left List / Right Details -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Certificate List View -->
            <ui:Card Grid.Column="0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding ViewModel.Certificates.Count, StringFormat='{}Found {0} certificate(s)'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="8,4,8,8" />

                    <ListView
                        Grid.Row="1"
                        ItemsSource="{Binding ViewModel.Certificates}"
                        SelectedItem="{Binding ViewModel.SelectedCertificate}"
                        BorderThickness="0"
                        Background="Transparent"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Status Dot -->
                                    <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{Binding HealthStatus, Converter={StaticResource HealthStatusToBrush}}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                    <!-- Common Name & Expiry -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CommonName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ExpirationSummary}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Private Key Icon & Algo -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <ui:SymbolIcon Symbol="Key24" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Visibility="{Binding HasPrivateKey, Converter={StaticResource BoolToVisibility}}" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding KeyAlgorithm}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </ui:Card>

            <!-- Certificate Details Inspector -->
            <ui:Card Grid.Column="2" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Visibility="{Binding ViewModel.SelectedCertificate, Converter={StaticResource NullToVisibility}}">

                        <!-- Title & Actions Bar -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding ViewModel.SelectedCertificate.CommonName}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding ViewModel.SelectedCertificate.StatusMessage}" FontSize="12" Foreground="{Binding ViewModel.SelectedCertificate.HealthStatus, Converter={StaticResource HealthStatusToBrush}}" FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button
                                    Icon="{ui:SymbolIcon Symbol=ShieldKeyhole24}"
                                    Content="Trust in Root"
                                    Command="{Binding ViewModel.TrustSelectedCertificateCommand}"
                                    Margin="0,0,6,0" />
                                <ui:Button
                                    Icon="{ui:SymbolIcon Symbol=ArrowDownload24}"
                                    Content="Export CRT"
                                    Command="{Binding ViewModel.ExportPemCommand}"
                                    Margin="0,0,6,0" />
                                <ui:Button
                                    Icon="{ui:SymbolIcon Symbol=FolderZip24}"
                                    Content="Export PFX"
                                    Command="{Binding ViewModel.ExportPfxCommand}"
                                    Margin="0,0,6,0" />
                                <ui:Button
                                    Icon="{ui:SymbolIcon Symbol=Delete24}"
                                    Appearance="Danger"
                                    Content="Delete"
                                    Command="{Binding ViewModel.DeleteSelectedCertificateCommand}" />
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,0,0,16" />

                        <!-- Fields Grid -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Subject:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.SelectedCertificate.Subject}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Issuer:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.SelectedCertificate.Issuer}" TextWrapping="Wrap" />
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Validity Window:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.SelectedCertificate.ExpirationSummary}" />
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Key &amp; Signature:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.SelectedCertificate.KeyAlgorithm, StringFormat='{}{0} '}" />
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SANs (Alt Names):" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.SelectedCertificate.SansDisplaySummary}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Thumbprint:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.SelectedCertificate.Thumbprint}" FontFamily="Consolas" TextWrapping="Wrap" />
                            <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Symbol=Copy24}" Content="Copy" Command="{Binding ViewModel.CopyThumbprintCommand}" Padding="8,4" FontSize="11" />
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Store Location:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.SelectedCertificate.StoreName, StringFormat='{}{0}'}" />
                        </Grid>

                        <!-- Raw PEM Card -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Certificate PEM Representation" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Symbol=Copy24}" Content="Copy PEM" Command="{Binding ViewModel.CopyPemCommand}" Padding="8,4" FontSize="11" />
                        </Grid>

                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <TextBox Text="{Binding ViewModel.SelectedCertificate.RawPem, Mode=OneWay}" FontFamily="Consolas" FontSize="11" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}" MaxHeight="180" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
