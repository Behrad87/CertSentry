<Page
    x:Class="CertSentry.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:CertSentry.Views.Converters"
    mc:Ignorable="d"
    d:DesignHeight="850" d:DesignWidth="1100"
    Title="Dashboard">

    <Page.Resources>
        <converters:HealthStatusToBrushConverter x:Key="HealthStatusToBrush" />
        <converters:HealthScoreToBrushConverter x:Key="HealthScoreToBrush" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32">

            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Localhost SSL/TLS Doctor" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="System certificate diagnostic center and automatic repair engine." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button
                        Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}"
                        Content="Re-run Diagnostics"
                        Command="{Binding ViewModel.RefreshHealthCommand}"
                        Margin="0,0,8,0" />
                    <ui:Button
                        Appearance="Primary"
                        Icon="{ui:SymbolIcon Symbol=Wrench24}"
                        Content="1-Click Repair All"
                        Command="{Binding ViewModel.RepairDevCertsCommand}" />
                </StackPanel>
            </Grid>

            <!-- Action Status Banner -->
            <ui:InfoBar
                IsOpen="True"
                Severity="Informational"
                Title="Status Notice"
                Message="{Binding ViewModel.ActionMessage}"
                Visibility="{Binding ViewModel.ActionMessage, Converter={StaticResource StringNotEmptyToVisibility}}"
                Margin="0,0,0,20" />

            <!-- Health Score Overview Card -->
            <ui:Card Margin="0,0,0,24" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Score Badge -->
                    <Border Grid.Column="0" CornerRadius="12" Width="100" Height="100" Background="{Binding ViewModel.HealthReport.HealthScore, Converter={StaticResource HealthScoreToBrush}}" VerticalAlignment="Center" Margin="0,0,24,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding ViewModel.HealthReport.HealthScore}" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                            <TextBlock Text="SCORE" FontSize="11" FontWeight="SemiBold" Foreground="White" Opacity="0.9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Overall Summary -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="System Health: " FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding ViewModel.HealthReport.HealthLevel}" FontSize="20" FontWeight="Bold" Foreground="{Binding ViewModel.HealthReport.HealthScore, Converter={StaticResource HealthScoreToBrush}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ViewModel.HealthReport.HealthSummary}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding ViewModel.StatusMessage}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontStyle="Italic" />
                    </StackPanel>

                    <!-- Stat Chips -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ViewModel.HealthReport.ValidDevCertsCount}" FontSize="18" FontWeight="Bold" Foreground="#107C41" HorizontalAlignment="Center" />
                                <TextBlock Text="Valid Certs" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ViewModel.HealthReport.ExpiringSoonCount}" FontSize="18" FontWeight="Bold" Foreground="#D89B00" HorizontalAlignment="Center" />
                                <TextBlock Text="Expiring Soon" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ViewModel.HealthReport.ExpiredCount}" FontSize="18" FontWeight="Bold" Foreground="#D13438" HorizontalAlignment="Center" />
                                <TextBlock Text="Expired" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- Subsystem Cards Grid -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ASP.NET Core Dev-Cert Subsystem -->
                <ui:Card Grid.Column="0" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                <ui:SymbolIcon Symbol="Code24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="ASP.NET Core Dev-Certs" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="8,2">
                                <TextBlock Text="Subsystem Active" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding ViewModel.HealthReport.AspNetStatusText}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" MinHeight="36" />

                        <StackPanel Orientation="Horizontal">
                            <ui:Button
                                Appearance="Primary"
                                Icon="{ui:SymbolIcon Symbol=Wrench24}"
                                Content="Repair &amp; Re-trust"
                                Command="{Binding ViewModel.RepairDevCertsCommand}"
                                Margin="0,0,8,0" />
                            <TextBlock Text="Resolves duplicate versions" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- Windows Store Health -->
                <ui:Card Grid.Column="2" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                <ui:SymbolIcon Symbol="Certificate24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Certificate Store Status" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="8,2">
                                <TextBlock Text="{Binding ViewModel.HealthReport.TotalDevCertsCount, StringFormat='{}{0} Dev Certs'}" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <TextBlock Text="Tracks all localhost, 127.0.0.1, dev.local, and developer authority certificates in Windows Personal and Trusted Root stores." FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" MinHeight="36" />

                        <StackPanel Orientation="Horizontal">
                            <ui:Button
                                Icon="{ui:SymbolIcon Symbol=DeleteDismiss24}"
                                Content="Purge Expired Certs"
                                Command="{Binding ViewModel.PurgeStaleCertsCommand}"
                                Margin="0,0,8,0" />
                            <TextBlock Text="Cleans expired dev certificates" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
            </Grid>

            <!-- Detected Issues Section -->
            <TextBlock Text="Active Diagnostic Issues &amp; Recommendations" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
            <ItemsControl ItemsSource="{Binding ViewModel.HealthReport.ActiveIssues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,10" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{Binding Severity, Converter={StaticResource HealthStatusToBrush}}" Margin="0,0,16,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,6" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Remedy: " FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding Remedy}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
