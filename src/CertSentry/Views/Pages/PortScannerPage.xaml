<Page
    x:Class="CertSentry.Views.Pages.PortScannerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:CertSentry.Views.Converters"
    mc:Ignorable="d"
    d:DesignHeight="850" d:DesignWidth="1100"
    Title="Port Scanner">

    <Page.Resources>
        <converters:HealthStatusToBrushConverter x:Key="HealthStatusToBrush" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" />
    </Page.Resources>

    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Localhost HTTPS Port Scanner" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock Grid.Row="0" Text="Fast asynchronous scanner for discovering active local web services and testing their SSL/TLS status." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,34,0,16" />

        <!-- Notification -->
        <ui:InfoBar
            Grid.Row="1"
            IsOpen="True"
            Severity="Informational"
            Message="{Binding ViewModel.NotificationMessage}"
            Visibility="{Binding ViewModel.NotificationMessage, Converter={StaticResource StringNotEmptyToVisibility}}"
            Margin="0,0,0,12" />

        <!-- Controls Card -->
        <ui:Card Grid.Row="2" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:Button
                        Grid.Column="0"
                        Appearance="Primary"
                        Icon="{ui:SymbolIcon Symbol=Radar20}"
                        Content="Scan Standard Ports"
                        Command="{Binding ViewModel.ScanDefaultPortsCommand}" />

                    <ui:TextBox
                        Grid.Column="2"
                        PlaceholderText="Custom ports: e.g. 3000, 5001, 8000-8010"
                        Text="{Binding ViewModel.CustomPortInput, UpdateSourceTrigger=PropertyChanged}"
                        Icon="{ui:SymbolIcon Symbol=NetworkCheck24}" />

                    <ui:Button
                        Grid.Column="4"
                        Icon="{ui:SymbolIcon Symbol=Search24}"
                        Content="Scan Custom"
                        Command="{Binding ViewModel.ScanCustomPortsCommand}" />

                    <ui:Button
                        Grid.Column="6"
                        Icon="{ui:SymbolIcon Symbol=Dismiss24}"
                        Content="Cancel"
                        Command="{Binding ViewModel.CancelScanCommand}"
                        Visibility="{Binding ViewModel.IsScanning, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <ProgressBar Height="4" IsIndeterminate="{Binding ViewModel.IsScanning}" Visibility="{Binding ViewModel.IsScanning, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0" />

                <TextBlock Text="{Binding ViewModel.StatusMessage}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
            </StackPanel>
        </ui:Card>

        <!-- Results Table -->
        <ui:Card Grid.Row="3" Padding="12">
            <ListView
                ItemsSource="{Binding ViewModel.Results}"
                SelectedItem="{Binding ViewModel.SelectedResult}"
                BorderThickness="0"
                Background="Transparent">
                <ListView.View>
                    <GridView>
                        <!-- Status Indicator -->
                        <GridViewColumn Header="Status" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="{Binding Status, Converter={StaticResource HealthStatusToBrush}}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Port -->
                        <GridViewColumn Header="Port" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Port}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Service / Description -->
                        <GridViewColumn Header="Service" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CommonServiceName}" FontSize="12" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Latency -->
                        <GridViewColumn Header="Latency" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LatencyMs, StringFormat='{}{0} ms'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Certificate Subject -->
                        <GridViewColumn Header="Certificate Subject" Width="320">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CertificateSubject}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Action -->
                        <GridViewColumn Header="Actions" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button
                                            Appearance="Secondary"
                                            Icon="{ui:SymbolIcon Symbol=Play24}"
                                            Content="Probe"
                                            Padding="6,3"
                                            FontSize="11"
                                            Margin="0,0,6,0"
                                            Command="{Binding DataContext.ViewModel.ProbePortInDoctorCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}" />
                                        <ui:Button
                                            Icon="{ui:SymbolIcon Symbol=Copy24}"
                                            Content="Copy"
                                            Padding="6,3"
                                            FontSize="11"
                                            Command="{Binding DataContext.ViewModel.CopyPortUrlCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </ui:Card>
    </Grid>
</Page>
